GEMINI_API_KEY=your_key_here
GOOGLE_TTS_API_KEY=
# Auth: leave AUTH_SECRET blank to auto-generate one (persisted to output/.auth_secret).
# Set GOOGLE_CLIENT_ID to a Google OAuth Web client ID to enable "Sign in with Google"
# (add http://localhost:8000 as an Authorized JavaScript origin in the Google console).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
OUTPUT_DIR=./output
PORT=8000
HEADLESS=false
# Auto-recording pace (lower = faster run). slow_mo is ms before each action;
# settle is seconds to wait after a click/navigation for the page to render.
RECORD_SLOW_MO=250
RECORD_SETTLE_S=0.6
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
